@page
@model myfschool_be.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = "Sửa User: " + Model.UserEdit?.FullName;
}

<a href="/Admin/Users" class="btn btn-secondary" style="margin-bottom:20px;">← Quay lại</a>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.UserEdit != null)
{
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
        <!-- Form sửa thông tin -->
        <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.08);">
            <h3 style="color:#1a237e;margin-bottom:16px;">📝 Thông tin cơ bản</h3>
            <form method="post" asp-page-handler="UpdateInfo">
                <input type="hidden" name="id" value="@Model.UserEdit.Id" />
                <div class="form-group">
                    <label>Họ tên</label>
                    <input type="text" name="fullName" class="form-control" value="@Model.UserEdit.FullName" required />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" class="form-control" value="@Model.UserEdit.Email" required />
                </div>
                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input type="text" name="phone" class="form-control" value="@Model.UserEdit.Phone" required />
                </div>
                <div class="form-group">
                    <label>Mã học sinh</label>
                    <input type="text" name="studentCode" class="form-control" value="@Model.UserEdit.StudentCode" />
                </div>
                <div class="form-group">
                    <label>Trạng thái</label>
                    <select name="isActive" class="form-control">
                        <option value="true" selected="@(Model.UserEdit.IsActive)">✅ Hoạt động</option>
                        <option value="false" selected="@(!Model.UserEdit.IsActive)">🚫 Bị khoá</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">💾 Lưu thay đổi</button>
            </form>
        </div>

        <!-- Panel phải: Role + Actions -->
        <div>
            <!-- Đổi Role -->
            <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.08);margin-bottom:20px;">
                <h3 style="color:#1a237e;margin-bottom:16px;">🔑 Vai trò hiện tại</h3>
                <div style="margin-bottom:16px;">
                    @foreach (var r in Model.UserEdit.Roles)
                    {
                        <span class="badge badge-@r.Name" style="font-size:14px;padding:6px 14px;">@r.Name</span>
                    }
                </div>
                <form method="post" asp-page-handler="ChangeRole">
                    <input type="hidden" name="id" value="@Model.UserEdit.Id" />
                    <div class="form-group">
                        <label>Đổi sang vai trò</label>
                        <select name="newRole" class="form-control">
                            <option value="student">Học sinh</option>
                            <option value="teacher">Giáo viên</option>
                            <option value="admin">Admin</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-secondary">Đổi vai trò</button>
                </form>
            </div>

            <!-- Reset Password -->
            <div style="background:#fff;padding:24px;border-radius:12px;box-shadow:0 2px 12px rgba(0,0,0,0.08);">
                <h3 style="color:#c62828;margin-bottom:16px;">🔒 Reset mật khẩu</h3>
                <p style="font-size:13px;color:#888;margin-bottom:12px;">
                    Đặt lại mật khẩu thành <strong>123456</strong> (BCrypt hash).
                    User sẽ bị đăng xuất khỏi tất cả thiết bị.
                </p>
                <form method="post" asp-page-handler="ResetPassword" 
                      onsubmit="return confirm('Reset mật khẩu user này thành 123456?')">
                    <input type="hidden" name="id" value="@Model.UserEdit.Id" />
                    <button type="submit" class="btn btn-danger">🔄 Reset mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">Không tìm thấy user</div>
}
